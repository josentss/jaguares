# Copy to .env and fill values before deploying
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-domain.example
TRUST_PROXY=1

# JWT
JWT_SECRET=replace_with_strong_secret

# MySQL (managed DB recommended)
DB_HOST=db
DB_USER=user
DB_PASSWORD=changeme
DB_NAME=club_jaguares
DB_ROOT_PASSWORD=rootpw

# ClamAV (if using system clam or container leave defaults)
CLAMAV_DB_DIR=/var/lib/clamav

# DigitalOcean Spaces (optional) - if using external storage
SPACES_ENDPOINT=
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=

# Purge script config
PURGE_DAYS=90
PURGE_BATCH=1000
